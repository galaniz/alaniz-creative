{
  "name": "alaniz-creative",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "build:client": "npx tsc --project tsconfig.client.json",
    "build:node": "npx tsc --project tsconfig.node.json",
    "build": "pnpm build:client && pnpm build:node && node lib/esbuild/esbuild.js --site",
    "watch:client": "npx tsc --watch --preserveWatchOutput --project tsconfig.client.json",
    "watch:node": "npx tsc --watch --preserveWatchOutput --project tsconfig.node.json",
    "watch:esbuild": "node scripts/watch.js",
    "start": "npm-run-all --parallel watch:node watch:client watch:esbuild",
    "typecheck:client": "npx tsc --noEmit --project tsconfig.client.json",
    "typecheck:node": "npx tsc --noEmit --project tsconfig.node.json",
    "typecheck:workers": "npx tsc --noEmit --project src/workers/tsconfig.json",
    "typecheck": "pnpm typecheck:client && pnpm typecheck:node && pnpm typecheck:workers",
    "lint:ts": "npx eslint .",
    "lint:scss": "stylelint 'src/**/*.scss'",
    "lint:content": "pnpm build:node && node lib/schema/schemaValidateCli.js",
    "lint": "pnpm lint:ts && pnpm lint:scss",
    "wrangler:contact": "npx wrangler dev --config src/workers/Contact/wrangler.json",
    "wrangler:content": "npx wrangler dev --config src/workers/Content/wrangler.json",
    "wrangler:file": "npx wrangler dev --remote --config src/workers/File/wrangler.json",
    "wrangler:password": "npx wrangler dev --config src/workers/Password/wrangler.json",
    "wrangler:site": "npx wrangler dev --config wrangler.json",
    "wrangler:snapshot": "npx wrangler dev --remote --config src/workers/Snapshot/wrangler.json",
    "wrangler:staging": "npx wrangler dev --config wrangler.json --env staging",
    "clean": "rm -rf node_modules/.cache/tsbuildinfo.* || true && rm -rf .cache || true && rm -rf site || true && rm -rf lib || true"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@alanizcreative/formation": "0.0.4",
    "@alanizcreative/formation-static": "0.0.6",
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@cloudflare/workers-types": "5.20260823.1",
    "@esbuild/linux-x64": "0.28.2",
    "@fullhuman/postcss-purgecss": "8.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.2.0",
    "@types/validator": "13.15.10",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "jose": "6.2.10",
    "postcss": "^8.5.26",
    "postcss-modules": "^9.0.1",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "uuid": "^14.0.2",
    "validator": "13.15.35",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "eslint": "10.9.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "8.67.0"
  },
  "optionalDependencies": {
    "nodemon": "3.1.14",
    "npm-run-all": "^4.1.5",
    "wrangler": "^4.125.0"
  },
  "browserslist": [
    "> 0.5%"
  ]
}
