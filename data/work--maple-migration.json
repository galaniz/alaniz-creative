        {
          "renderType": "container",
          "maxWidth": "xs",
          "richTextStyles": true,
          "content": [
            {
              "renderType": "richText",
              "tag": "h3",
              "content": "Edge Static Site"
            },
            {
              "renderType": "richText",
              "tag": "p",
              "content": "Optimizing the existing site incrementally was considered, but was decided against because of the high effort and modest gains from improvements like opting for a lighter plugin or switching to a faster host. Going static with serverless functionality through Cloudflare Workers removed the entire class of problems in one move instead."
            },
            {
              "renderType": "richText",
              "tag": "ul",
              "content": [
                {
                  "tag": "li",
                  "content": [
                    {
                      "tag": "strong",
                      "content": "Static site generation: "
                    },
                    {
                      "content": [
                        {
                          "tag": "a",
                          "link": "https://github.com/galaniz/formation-static",
                          "content": "Formation Static"
                        },
                        {
                          "content": " handles site generation, and "
                        },
                        {
                          "tag": "a",
                          "link": "https://github.com/galaniz/formation",
                          "content": "Formation"
                        },
                        {
                          "content": " handles web components and styles for an optimized front end."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "content": [
                    {
                      "tag": "strong",
                      "content": "Geotargeting: "
                    },
                    {
                      "content": "Cloudflare-provided geolocation information allows redirects and content rewrites at the edge, replacing client-side logic."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "content": [
                    {
                      "tag": "strong",
                      "content": "Optimized media: "
                    },
                    {
                      "content": "Uploads now live in Cloudflare R2, served through a Worker that transforms width, height, format and quality."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "content": [
                    {
                      "tag": "strong",
                      "content": "SEO preservation: "
                    },
                    {
                      "content": "Redirects compile into static 301s at build time, alongside more consistent per-page schema and auto-generated sitemaps."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
