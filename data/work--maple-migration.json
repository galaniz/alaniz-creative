              "content": "Requirements"
            },
            {
              "renderType": "richText",
              "tag": "ul",
              "content": [
                {
                  "tag": "li",
                  "content": "Editable for the entire marketing team, in both English and French"
                },
                {
                  "tag": "li",
                  "content": "Region-specific content based on geolocation"
                },
                {
                  "tag": "li",
                  "content": [
                    {
                      "content": "Preserve existing "
                    },
                    {
                      "tag": "strong",
                      "content": "SEO value "
                    },
                    {
                      "content": "and minimize content loss"
                    }
                  ]
                }
              ]
            }
          ]
