            {
              "renderType": "richText",
              "tag": "h2",
              "content": "The Outcome"
            },
            {
              "renderType": "richText",
              "tag": "p",
              "content": [
                {
                  "content": "A month after launch, Core Web Vitals passed across every one of the top pages. Search Console also told the same story. Pages flagged as "
                },
                {
                  "tag": "em",
                  "content": "poor"
                },
                {
                  "content": " or "
                },
                {
                  "tag": "em",
                  "content": "needing improvement"
                },
                {
                  "content": " dropped to zero across both mobile and desktop, and the count of "
                },
