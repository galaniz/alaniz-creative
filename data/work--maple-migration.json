              "content": "Goals"
            },
            {
              "renderType": "richText",
              "tag": "ul",
              "content": [
                {
                  "tag": "li",
                  "content": [
                    {
                      "content": "Pass Core Web Vitals across the top 20 pages by traffic, with a focus on "
                    },
                    {
                      "tag": "strong",
                      "content": "Largest Contentful Paint "
                    },
                    {
                      "content": "(LCP), "
                    },
                    {
                      "tag": "strong",
                      "content": "Cumulative Layout Shift "
                    },
                    {
                      "content": " (CLS) and "
                    },
                    {
                      "tag": "strong",
                      "content": "Time to First Byte "
                    },
                    {
                      "content": "(TTFB)"
                    }
                  ]
                },
                {
                  "tag": "li",
                  "content": "Simplify the deploy and content-editing workflow, and reduce hosting cost"
                },
                {
                  "tag": "li",
                  "content": "Replace page-by-page custom styling with a consistent, on-brand design system"
                }
              ]
            },
            {
              "renderType": "richText",
