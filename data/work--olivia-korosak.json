              "content": "Post-migration desktop work, project and track archive and entry pages."
            }
          ]
        },
        {
          "renderType": "container",
          "maxWidth": "xs",
          "richTextStyles": true,
          "content": [
            {
              "renderType": "richText",
              "tag": "h3",
              "content": "Headless Static Site"
            },
            {
              "renderType": "richText",
              "tag": "p",
              "content": "Rather than iterate on the existing WordPress theme, the redesign was an opportunity to start fresh. With rising hosting costs and the ongoing admin maintenance that comes with any monolithic CMS, a managed headless CMS and static host, both with generous free tiers, made the most sense."
            },
            {
              "renderType": "richText",
              "tag": "ul",
              "content": [
                {
                  "tag": "li",
                  "content": [
                    {
                      "tag": "strong",
                      "content": "Static site generation: "
                    },
                    {
                      "content": [
                        {
                          "tag": "a",
                          "link": "https://github.com/galaniz/formation-static",
                          "content": "Formation Static"
                        },
                        {
                          "content": " generates every page ahead of time and "
                        },
                        {
                          "tag": "a",
                          "link": "https://github.com/galaniz/formation",
                          "content": "Formation"
                        },
                        {
                          "content": " provides lightweight front-end web components and styles."
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "li",
                  "content": [
                    {
                      "tag": "strong",
                      "content": "Headless CMS: "
                    },
                    {
                      "content": "Contentful manages all content with no self-hosted admin to maintain, serving assets from its CDN with dynamic image resizing."
                    }
                  ]
                },
                {
                  "tag": "li",
                  "content": [
                    {
                      "tag": "strong",
                      "content": "Edge hosting: "
                    },
                    {
                      "content": "Cloudflare Workers serve the site from the edge for fast load times with serverless flexibility only where needed."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
