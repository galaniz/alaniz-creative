{
  "name": "alaniz-creative-password",
  "main": "./PasswordWorker.ts",
  "compatibility_date": "2026-05-11",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "routes": [
    {
      "pattern": "alanizcreative.com/api/password",
      "zone_name": "alanizcreative.com"
    }
  ],
  "vars": {
    "CF_PASSWORD_ALLOWED_ORIGINS": "https://alanizcreative.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "dev": {
      "main": "./PasswordWorker.ts",
      "workers_dev": false,
      "preview_urls": false,
      "minify": true,
      "vars": {
        "CF_PASSWORD_ALLOWED_ORIGINS": "https://staging.alanizcreative.com"
      },
      "routes": [
        {
          "pattern": "alanizcreative.com/api/password-dev",
          "zone_name": "alanizcreative.com"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
